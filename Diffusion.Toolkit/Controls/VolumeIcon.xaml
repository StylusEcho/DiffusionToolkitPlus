<UserControl x:Class="Diffusion.Toolkit.Controls.VolumeIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self"
             IsHitTestVisible="False">

    <!-- Drawn rather than taken from FontAwesome: 4.x has no muted speaker, only VolumeOff,
         which is the bare speaker - and scaled to the same width as VolumeUp it came out bigger
         rather than looking muted. Here both states share the one speaker, at the one size, and
         differ only in what is beside it: sound waves, or a cross. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="M3,9 H7 L12,4 V20 L7,15 H3 Z"
                  Fill="{Binding Foreground, ElementName=Self}"/>

            <Path x:Name="Waves"
                  Data="M15.5,8.5 A5,5 0 0 1 15.5,15.5 M18,5.5 A9,9 0 0 1 18,18.5"
                  Stroke="{Binding Foreground, ElementName=Self}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <Path x:Name="Cross" Visibility="Collapsed"
                  Data="M16,9 L22,15 M22,9 L16,15"
                  Stroke="{Binding Foreground, ElementName=Self}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>
</UserControl>
